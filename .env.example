[TEMPLATE]
# Configuración del servicio ig-gateway (nunca versionar el .env real).

# Puerto local del servicio.
PORT=4005
IG_GRAPH_VERSION=v27.0

# URL pública desde la que Instagram descarga el media staged (nginx).
IG_MEDIA_BASE_URL=https://your-domain.example/ig-media

# Token de su API local (cabecera x-ig-gateway-token). En producción, 600.
IG_GATEWAY_TOKEN=change-me

# 1 = no publica de verdad: recorre el flujo sin llamar a la API de Instagram.
IG_DRY_RUN=0

# Registro de cuentas: un fichero por cuenta (permisos 600).
IG_ACCOUNTS_DIR=./data/accounts

# Copias temporales para publicar y su barrido (horas).
IG_STAGING_DIR=./data/media
IG_STAGING_TTL_HOURS=48

# Registro de publicaciones (JSONL) y logs del servicio.
IG_PUBLICATION_LOG=./data/logs/publications.jsonl

# Cuota: se cachea este tiempo (ms) y se pregunta igual si queda poco margen.
IG_QUOTA_TTL_MS=300000

# Registro compartido de llamadas (contador visible en check y /health).
# Si se deja vacío, el contador solo cuenta el proceso en curso.
IG_CALLS_LOG=./data/logs/calls.jsonl

# Freno suave de llamadas a Meta por minuto (espera, nunca falla).
IG_MAX_CALLS_PER_MINUTE=30
